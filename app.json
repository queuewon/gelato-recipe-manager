{
  "expo": {
    "name": "Indigo Gelato",
    "slug": "indigo-gelato",
    "scheme": "gelato",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/indigo-gelato-heart.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/indigo-gelato-heart.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.queuewon.gelatoapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/indigo-gelato-heart.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.queuewon.gelatoapp",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-sqlite",
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fbaf146a-528f-4efd-b6fc-585e07fe56d8"
      }
    },
    "owner": "oneiricxel"
  }
}
