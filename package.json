{
  "name": "gelato-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "check-deps": "node scripts/check-deps.mjs",
    "check-routes": "node scripts/check-routes.mjs",
    "check-bool-props": "node scripts/check-bool-props.mjs",
    "check": "node scripts/check-deps.mjs && node scripts/check-routes.mjs && node scripts/check-bool-props.mjs",
    "start": "npm run check && expo start",
    "android": "npm run check && expo start --android",
    "ios": "npm run check && expo start --ios",
    "web": "npm run check && expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
